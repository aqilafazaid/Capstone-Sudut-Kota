/* --- 1. GLOBAL & SCROLLBAR --- */
body {
    -webkit-tap-highlight-color: transparent;
}

::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: #020617; }
::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: #38bdf8; }

.premium-scroll::-webkit-scrollbar { width: 6px; }
.premium-scroll::-webkit-scrollbar-track { background: transparent; }
.premium-scroll::-webkit-scrollbar-thumb { background-color: #334155; border-radius: 10px; }
.premium-scroll::-webkit-scrollbar-thumb:hover { background-color: #475569; }


/* --- 2. TEMA GELAP PREMIUM & GLASSMORPHISM (Untuk Dashboard & About) --- */
.bg-mesh-premium {
    background-color: #020617;
    background-image: 
        radial-gradient(circle at 15% 50%, rgba(14, 165, 233, 0.12) 0px, transparent 40%),
        radial-gradient(circle at 85% 30%, rgba(59, 130, 246, 0.12) 0px, transparent 40%),
        radial-gradient(circle at 50% 80%, rgba(16, 185, 129, 0.05) 0px, transparent 40%);
    background-attachment: fixed;
}

.glass-card-premium {
    background: rgba(30, 41, 59, 0.4);
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border-radius: 1.5rem;
}

.glass-stat-premium {
    background: linear-gradient(145deg, rgba(30,41,59,0.5) 0%, rgba(15,23,42,0.8) 100%);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    border-radius: 1.5rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-stat-premium:hover {
    transform: translateY(-8px);
    border-color: rgba(14, 165, 233, 0.4);
    box-shadow: 0 20px 40px -10px rgba(14, 165, 233, 0.2);
}


/* --- 3. KOMPONEN PEMUTAR VIDEO CCTV --- */
.player-card {
    border-radius: 1.5rem; 
    overflow: hidden; 
    background: #000;
    box-shadow: 0 20px 50px -15px rgba(14, 165, 233, 0.3);
    display: flex; 
    flex-direction: column;
    border: 1px solid rgba(255,255,255,0.1);
}
 
.player-header {
    background: linear-gradient(to right, #0f172a, #0369a1);
    padding: 16px 20px; 
    color: white;
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.video-wrapper { 
    position: relative; width: 100%; padding-top: 56.25%; background: #000; overflow: hidden; 
}

.video-element { 
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: fill; 
}


/* --- 4. INDIKATOR AI MENGAMBANG (Floating Badges) --- */
.ai-overlay-status {
    position: absolute; top: 16px; right: 16px; z-index: 30;
    display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
}

.ai-badge {
    background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.2); padding: 6px 14px;
    border-radius: 8px; font-size: 11px; font-weight: 700; color: white;
    display: flex; align-items: center; gap: 8px; transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.5);
}

.ai-badge.active { background: rgba(14, 165, 233, 0.85); border-color: #7dd3fc; }
.ai-badge.active-green { background: rgba(16, 185, 129, 0.85); border-color: #6ee7b7; }


/* --- 5. SAKELAR ANIMASI (Toggle Button AI) --- */
input:checked ~ .toggle-bg { background-color: #0ea5e9; }
input:checked ~ .toggle-dot { transform: translateX(100%); background-color: #fff; }


/* --- 6. SIDEBAR AKORDION (Daftar Kamera CCTV) --- */
.accordion-group { 
    margin-bottom: 12px; border: 1px solid #1e293b; border-radius: 16px; 
    background: #0f172a; overflow: hidden; 
}
.group-header { 
    padding: 14px 18px; cursor: pointer; display: flex; 
    justify-content: space-between; align-items: center; transition: all 0.2s; 
}
.group-header:hover { background: #1e293b; }
.group-header.active { background: #1e293b; border-bottom: 1px solid #334155; }

.group-body { max-height: 0; overflow: hidden; transition: max-height 0.4s ease; background: #0f172a; }
