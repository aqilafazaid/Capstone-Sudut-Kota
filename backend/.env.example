# =============================================================================
# Sudut Kota — template konfigurasi backend
# Salin ke .env lalu isi. Jangan pernah commit .env.
#
#   cp backend/.env.example backend/.env
#
# Blok 1 (Web SDK)    : nilai PUBLIK, ikut dikirim ke peramban lewat
#                       frontend/js/firebase-config.js.
# Blok 2 (Admin SDK)  : RAHASIA. Hanya ada di mesin backend.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase Web SDK — Firebase Console > Project settings > General >
#    Your apps > Web app > SDK setup and configuration > Config
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# 2. Firebase Admin SDK — Firebase Console > Project settings > Service accounts
#    > Generate new private key (file JSON). Salin tiap field JSON ke kunci di
#    bawah. FIREBASE_PROJECT_ID memakai nilai yang sama dengan blok 1.
#    Kosong = endpoint baca tetap 200, endpoint tulis balas 503.
# -----------------------------------------------------------------------------
FIREBASE_TYPE=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=

# -----------------------------------------------------------------------------
# 3. Server API — Flask hanya bind loopback; nginx yang menghadap jaringan.
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=5000

# Origin yang boleh memanggil /api dari peramban (dipisah koma, tanpa spasi).
# Isi domain produksi Vercel + port dev yang dipakai.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8787,http://localhost:8787

# URL publik backend (Tailscale Funnel), tanpa garis miring di akhir.
# Dipakai `python backend/scripts/sync_public_config.py` untuk menghasilkan
# frontend/js/public-config.js. Contoh: https://pc-dishub.tailXXXX.ts.net
PUBLIC_BACKEND_URL=

# -----------------------------------------------------------------------------
# 4. Penyimpanan
# -----------------------------------------------------------------------------
# Path relatif dihitung dari folder backend/.
NODE_DB=data/sudutkota.db
HLS_OUT_DIR=media/hls

# -----------------------------------------------------------------------------
# 5. Stream
# -----------------------------------------------------------------------------
STREAM_AUTOSTART=true
# Engine AI per kamera (low-light + YOLO -> HLS). true: wajib; false: ffmpeg polos.
# Kosongkan untuk otomatis: aktif bila ai_engine/main_ai.py + bobot YOLO ada.
AI_ENGINE=true
# Varian low-light default. Pilihan: mirnetv1, mirnetv2_kaggle, mirnetv2_paper,
# mobile_mirnet, zerodce, cbam_unet_dce (lihat LowLightEnhancement/catalog.py).
# mobile_mirnet: kualitas MirNet, ~6-7 fps; zerodce/cbam_unet_dce: 11-13 fps.
AI_LOWLIGHT_MODEL=mobile_mirnet
# Kanvas HLS: 0 = resolusi asli sumber (yang tampil di web tetap tajam).
AI_MAX_SIDE=0
# Sisi terpanjang frame kerja AI (enhance + YOLO). Lebih kecil = lebih ringan.
# Mode CPU otomatis memakai 640 kalau variabel ini tidak diisi.
AI_AI_SIDE=960
# Keyframe tiap N frame (GOP). 12 -> segmen HLS ~2-3 dtk.
# Nilai besar (30) menghemat bitrate tetapi menambah latensi pemutar.
AI_HLS_GOP=12
# Ukuran YOLO dan ambang confidence.
AI_YOLO_IMGSZ=640
AI_YOLO_CONF=0.35
# Device AI: auto (GPU NVIDIA bila ada, kalau tidak CPU) | cpu | cuda:0.
# Tanpa GPU, `auto` sudah otomatis CPU+RAM: video tetap ~real-time karena
# enhance/deteksi berjalan di thread terpisah dari jalur tampilan.
AI_DEVICE=auto
# FP16 di GPU: ~1,5x lebih cepat (Mobile-MIRNet 85 -> 60 ms). 0 = paksa FP32.
AI_FP16=1
# Berapa kali per detik model low-light dijalankan (LUT kecerahan berubah
# lambat). Deteksi YOLO tidak dibatasi angka ini.
AI_ENHANCE_HZ=6
# Encoder HLS: auto (NVENC bila ada) | nvenc | libx264. NVENC memindahkan
# encoding 1080p dari CPU ke GPU.
AI_ENCODER=auto
# Mutu encoder; kosong = 20 untuk libx264, 26 untuk NVENC (skalanya beda).
AI_CRF=
# Jumlah frame yang ditahan pembaca RTSP. 1 = paling rendah latensi tetapi
# burst kamera dibuang; 3 = lebih mulus, +~0,12 dtk latensi.
AI_SOURCE_BUFFER=3
# Thread torch/OpenCV di mode CPU (kosong = semua core).
AI_CPU_THREADS=
# Matikan modul tanpa mengubah kode: AI_LOWLIGHT=false / AI_YOLO=false / AI_RTDB=false.
AI_LOWLIGHT=true
AI_YOLO=true
# Izinkan sumber http(s) selain rtsp (hanya untuk stream uji). Produksi: false.
ALLOW_TEST_SOURCES=false

# -----------------------------------------------------------------------------
# 6. Statistik (kolektor telemetri RTDB)
# -----------------------------------------------------------------------------
# Aktifkan kolektor saat app.py dijalankan.
STATS_COLLECTOR=true
# Jarak antar sampel (detik). Satu sampel = satu pembacaan cam_<channel>.
STATS_SAMPLE_SECONDS=60
# Lewati snapshot AI yang lebih tua dari ini (detik); mencegah stream mati
# terus menambah angka.
STATS_STALE_SECONDS=300
# Rentang data yang dibaca halaman/ekspor (hari). Default 4000 menutup periode
# "Seluruhnya" (arsip sejak 2019) tanpa memotong data.
STATS_MAX_DAYS=4000
# Cache agregat di memori backend (detik).
STATS_CACHE_SECONDS=30
