# =============================================================================
# Sudut Kota — template konfigurasi backend
# Salin ke .env lalu isi. Jangan pernah commit .env.
#
#   cp backend/.env.example backend/.env
#
# Blok 1 (Web SDK)    : nilai PUBLIK, ikut dikirim ke peramban lewat
#                       frontend/js/firebase-config.js.
# Blok 2 (Admin SDK)  : RAHASIA. Hanya ada di mesin backend.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase Web SDK — Firebase Console > Project settings > General >
#    Your apps > Web app > SDK setup and configuration > Config
# -----------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# 2. Firebase Admin SDK — Firebase Console > Project settings > Service accounts
#    > Generate new private key (file JSON). Salin tiap field JSON ke kunci di
#    bawah. FIREBASE_PROJECT_ID memakai nilai yang sama dengan blok 1.
#    Kosong = endpoint baca tetap 200, endpoint tulis balas 503.
# -----------------------------------------------------------------------------
FIREBASE_TYPE=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=

# -----------------------------------------------------------------------------
# 3. Server API — Flask hanya bind loopback; nginx yang menghadap jaringan.
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=5000

# Origin yang boleh memanggil /api dari peramban (dipisah koma, tanpa spasi).
# Isi domain produksi Vercel + port dev yang dipakai.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8787,http://localhost:8787

# URL publik backend (Tailscale Funnel), tanpa garis miring di akhir.
# Dipakai `python backend/scripts/sync_public_config.py` untuk menghasilkan
# frontend/js/public-config.js. Contoh: https://pc-dishub.tailXXXX.ts.net
PUBLIC_BACKEND_URL=

# -----------------------------------------------------------------------------
# 4. Penyimpanan
# -----------------------------------------------------------------------------
# Path relatif dihitung dari folder backend/.
NODE_DB=data/sudutkota.db
HLS_OUT_DIR=media/hls

# Kunci enkripsi kolom `rtsp` di SQLite (AES-256-GCM, 32 byte base64/hex).
# Buat sekali:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Kosong = kunci dibaca dari berkas backend/data/node_secret.key, dan berkas itu
# dibuat otomatis pada penulisan pertama. Isi variabel ini bila kunci ingin
# disimpan di .env (mis. folder data/ tidak bisa ditulisi proses backend).
# Simpan kunci di luar database: tanpa kunci itu URL yang sudah terenkripsi
# tidak bisa dibuka (stream berhenti). Baris lama (teks biasa) tetap terbaca;
# ubah semuanya dengan: python scripts/encrypt_rtsp.py --apply
NODE_SECRET=

# --- Kontrol stream ---
STREAM_AUTOSTART=true
ALLOW_TEST_SOURCES=false

# Umur cache feed Instagram (detik). 300 = maksimal 5 menit sekali scrape.
IG_CACHE_SECONDS=300
