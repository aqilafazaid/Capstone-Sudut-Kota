*.pt
*.pth
*.weights
# Mengabaikan folder output bawaan Ultralytics YOLO
runs/
# Mengabaikan dataset gambar/video lokal
datasets/
images/
labels/

# ==========================================
# 4. OUTPUT VIDEO & STREAMING (HLS)
# ==========================================
